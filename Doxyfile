# ---------------------------------------
# Minimal Doxyfile for C++ API Documents
#----------------------------------------

# 要生成 HTML（网页）
GENERATE_HTML       = YES
HTML_OUTPUT         = ../doc/html

# 不要生成 xml / latex / man / rtf
GENERATE_LATEX      = NO
GENERATE_XML        = NO
GENERATE_MAN        = NO
GENERATE_RTF        = NO

# 输入目录（你的项目 include/ 和 src/）
INPUT               = ../include ../src

# 是否递归子目录
RECURSIVE           = YES

# 不写注释也显示（可选）
EXTRACT_ALL         = YES

# 保留默认即可
QUIET               = NO
WARNINGS            = YES
